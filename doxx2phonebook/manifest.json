{
  "manifest_version": 3,
  "name": "doxx2phone",
  "version": "1.0",
  "description": "Generate and copy USPhoneBook URLs from selected Doximity profile names..",
  "permissions": [
    "contextMenus",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.doximity.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}